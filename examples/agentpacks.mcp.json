{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "mcp-filesystem",
      "args": ["${PLUGIN_DATA}/workspace"]
    },
    "database": {
      "type": "stdio",
      "command": "mcp-database",
      "args": ["--db", "main=sqlite:${PLUGIN_DATA}/main.db", "--read-only"]
    },
    "roslyn": {
      "type": "stdio",
      "command": "mcp-roslyn",
      "args": ["--no-scripting"],
      "env": { "MCP_ROSLYN_ROOT": "${PLUGIN_DATA}" }
    },
    "index": {
      "type": "stdio",
      "command": "mcp-index",
      "args": ["--store", "sqlite:${PLUGIN_DATA}/index/index.db", "--auto-refresh", "inline"]
    },
    "learnings": {
      "type": "stdio",
      "command": "mcp-learnings",
      "args": ["--store", "sqlite:${PLUGIN_DATA}/learnings/learnings.db", "--data-dir", "${PLUGIN_DATA}/learnings", "--dispatch", "manual"],
      "env": { "MCP_LEARNINGS_REPO": "svennijhuis/agentPacks" }
    }
  }
}
