# Required for Streamable HTTP. Containers bind 0.0.0.0 inside the network, so the host
# refuses to start without a bearer token. Generate one:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional: public HTTPS origin of a tunnel or reverse proxy (no trailing slash).
# Advertised in server_info and added to the Host allow-list.
# MCP_PUBLIC_URL=https://your-subdomain.trycloudflare.com

# Optional: extra Host header values, comma or semicolon separated. Use * for throwaway tunnels.
# MCP_ALLOWED_HOSTS=*

# Optional: browser CORS origins (Grok Bot is server-side and does not need this).
# MCP_CORS_ORIGINS=https://grok.com

# Shared PostgreSQL
# POSTGRES_PASSWORD=mcp

# Absolute path mounted at /workspace for filesystem, roslyn and index.
# WORKSPACE=/abs/path/to/repo

# Optional server-specific secrets and settings
# CURSOR_API_KEY=
# OPENAI_API_KEY=
# MCP_INDEX_EMBEDDINGS=openai:text-embedding-3-small
# MCP_LEARNINGS_REPO=owner/name
# MCP_LEARNINGS_TARGET_REPOS=
# MCP_LEARNINGS_DISPATCH=manual
